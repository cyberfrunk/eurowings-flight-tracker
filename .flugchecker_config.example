# Copy to /home/pi/.flugchecker_config and fill in your own values.
# NEVER commit the real file.

# Calendar
ICS_URL=

# Home Assistant / FlightRadar24 (current version)
HA_URL=http://HOME_ASSISTANT_IP:8123
HA_TOKEN=

# OpenSky - current Phase 1 landing tracker
OPENSKY_USER=
OPENSKY_PASS=

# Mail account used for outgoing event e-mails
MAIL_USER=
MAIL_PASSWORD=
MY_MAIL=
WIFE_MAIL=

# Location
HOME_LAT=
HOME_LON=
RADIUS_KM=25
INFO_RADIUS_KM=50

# Network / devices
SONOS_IP=
PI_IP=
HTTP_PORT=8000
HOMEPILOT_URL=http://HOMEPILOT_IP/devices/DEVICE_ID
